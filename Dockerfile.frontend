# ==========================================
# DOCKERFILE - E-LEARNING NATACIÓN (FRONTEND)
# ==========================================
# Este Dockerfile construye el frontend de React + Vite
# Para usar este Dockerfile:
#   docker build -f Dockerfile.frontend -t elearning-natacion-frontend .
# ==========================================

# ==========================================
# STAGE 1: Build
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar archivos de dependencias
COPY frontend/package*.json ./

# Instalar dependencias
RUN npm ci && \
    npm cache clean --force

# Copiar código fuente
COPY frontend/ ./

# Build de producción con Vite
RUN npm run build && \
    echo "✅ Build completado. Archivos generados en /app/dist"

# Verificar que dist fue generado
RUN test -d "dist" || (echo "❌ Error: dist/ no fue generado" && exit 1)

# ==========================================
# STAGE 2: Production (Nginx)
# ==========================================
FROM nginx:alpine AS runner

# Copiar configuración personalizada de nginx
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar build de producción
COPY --from=builder /app/dist /usr/share/nginx/html

# Crear script de inicio que verifica la configuración
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'echo "🚀 Iniciando E-Learning Natación Frontend..."' >> /docker-entrypoint.sh && \
    echo 'echo ""' >> /docker-entrypoint.sh && \
    echo 'echo "🔍 Verificando archivos..."' >> /docker-entrypoint.sh && \
    echo 'ls -lh /usr/share/nginx/html/ | head -10' >> /docker-entrypoint.sh && \
    echo 'echo ""' >> /docker-entrypoint.sh && \
    echo 'echo "📋 Verificando configuración de Nginx..."' >> /docker-entrypoint.sh && \
    echo 'nginx -t' >> /docker-entrypoint.sh && \
    echo 'echo ""' >> /docker-entrypoint.sh && \
    echo 'echo "✅ Frontend listo. Iniciando Nginx..."' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Exponer puerto 80
EXPOSE 80

# Comando de inicio
CMD ["/docker-entrypoint.sh"]

# ==========================================
# BUILD INSTRUCTIONS
# ==========================================
# Para construir esta imagen:
#   docker build -f Dockerfile.frontend -t elearning-natacion-frontend .
#
# Para ejecutar:
#   docker run -p 80:80 elearning-natacion-frontend
#
# Para ejecutar en otro puerto:
#   docker run -p 8080:80 elearning-natacion-frontend
#
# Acceder en: http://localhost (o puerto especificado)
# ==========================================
