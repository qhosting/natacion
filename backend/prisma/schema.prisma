// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUMNO
  ADMIN
}

enum MediaType {
  VIDEO
  AUDIO
  IMAGE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  apellido  String?
  role      Role     @default(ALUMNO)
  puntos    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  inscripciones Inscripcion[]
  progresos     Progreso[]
  comentarios   Comentario[]
  insignias     UserInsignia[]
  certificados  Certificado[]

  @@map("users")
}

model Curso {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  imagen      String?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  etapas        Etapa[]
  inscripciones Inscripcion[]
  certificados  Certificado[]

  @@map("cursos")
}

model Etapa {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int      @default(0)
  cursoId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  curso     Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  lecciones Leccion[]

  @@map("etapas")
}

model Leccion {
  id          Int      @id @default(autoincrement())
  titulo      String
  contenido   String?  @db.Text
  orden       Int      @default(0)
  etapaId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  etapa       Etapa        @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  medios      Media[]
  progresos   Progreso[]
  comentarios Comentario[]

  @@map("lecciones")
}

model Media {
  id           Int       @id @default(autoincrement())
  tipo         MediaType
  titulo       String?
  url          String
  urlHls       String?   // Para streaming HLS
  thumbnail    String?
  duracion     Int?      // En segundos
  tamano       Int?      // En bytes
  leccionId    Int
  orden        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  leccion Leccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@map("medias")
}

model Inscripcion {
  id        Int      @id @default(autoincrement())
  userId    Int
  cursoId   Int
  progreso  Float    @default(0) // Porcentaje de 0 a 100
  completado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([userId, cursoId])
  @@map("inscripciones")
}

model Progreso {
  id          Int      @id @default(autoincrement())
  userId      Int
  leccionId   Int
  completado  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leccion Leccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([userId, leccionId])
  @@map("progresos")
}

model Comentario {
  id        Int      @id @default(autoincrement())
  contenido String   @db.Text
  userId    Int
  leccionId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leccion Leccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

model Insignia {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  icono       String?
  criterio    String   // e.g. "curso_completado", "puntos_1000"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserInsignia[]

  @@map("insignias")
}

model UserInsignia {
  id         Int      @id @default(autoincrement())
  userId     Int
  insigniaId Int
  awardedAt  DateTime @default(now())

  // Relaciones
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insignia Insignia @relation(fields: [insigniaId], references: [id], onDelete: Cascade)

  @@unique([userId, insigniaId])
  @@map("users_insignias")
}

model Certificado {
  id            String   @id @default(uuid()) // UUID for public verification URL
  userId        Int
  cursoId       Int
  fechaEmision  DateTime @default(now())
  pdfUrl        String?  // If we store the generated PDF

  // Relaciones
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([userId, cursoId])
  @@map("certificados")
}
