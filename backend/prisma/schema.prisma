// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUMNO
  ADMIN
}

enum MediaType {
  VIDEO
  AUDIO
  IMAGE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  apellido  String?
  role      Role     @default(ALUMNO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  inscripciones Inscripcion[]
  progresos     Progreso[]

  @@map("users")
}

model Curso {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  imagen      String?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  etapas        Etapa[]
  inscripciones Inscripcion[]

  @@map("cursos")
}

model Etapa {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String?
  orden       Int      @default(0)
  cursoId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  curso     Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  lecciones Leccion[]

  @@map("etapas")
}

model Leccion {
  id          Int      @id @default(autoincrement())
  titulo      String
  contenido   String?  @db.Text
  orden       Int      @default(0)
  etapaId     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  etapa     Etapa      @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  medios    Media[]
  progresos Progreso[]

  @@map("lecciones")
}

model Media {
  id           Int       @id @default(autoincrement())
  tipo         MediaType
  titulo       String?
  url          String
  urlHls       String?   // Para streaming HLS
  thumbnail    String?
  duracion     Int?      // En segundos
  tamano       Int?      // En bytes
  leccionId    Int
  orden        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  leccion Leccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@map("medias")
}

model Inscripcion {
  id        Int      @id @default(autoincrement())
  userId    Int
  cursoId   Int
  progreso  Float    @default(0) // Porcentaje de 0 a 100
  completado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  curso Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([userId, cursoId])
  @@map("inscripciones")
}

model Progreso {
  id          Int      @id @default(autoincrement())
  userId      Int
  leccionId   Int
  completado  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  leccion Leccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@unique([userId, leccionId])
  @@map("progresos")
}
