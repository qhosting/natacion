# ==========================================
# .dockerignore - E-Learning Natación
# ==========================================
# Excluye archivos innecesarios del contexto de Docker
# para builds más rápidos y imágenes más pequeñas
# ==========================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/
REPORTE*.md
RESUMEN.md
INICIO-RÁPIDO.md

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Logs
logs/
*.log
pids
*.pid
*.seed
*.pid.lock

# Environment
.env
.env.local
.env.*.local
.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
test/
tests/
**/*.test.js
**/*.spec.js

# Build artifacts (se construyen en el contenedor)
dist/
build/
.next/
out/

# Uploads (se montan como volúmenes)
uploads/
*.mp4
*.mp3
*.m3u8
*.ts

# Backups
backups/
*.sql
*.dump

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Scripts de desarrollo
scripts/
init-*.sh

# Temporal
tmp/
temp/
*.tmp

# Sistema operativo
Thumbs.db
.DS_Store
desktop.ini

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Prisma (se genera en el contenedor)
prisma/migrations/*.sql

# Cache
.cache/
.parcel-cache/
.eslintcache
